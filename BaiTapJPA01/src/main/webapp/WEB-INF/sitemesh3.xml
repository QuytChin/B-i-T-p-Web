<?xml version="1.0" encoding="UTF-8"?>

<sitemesh>

    <decorator-prefix>
        /WEB-INF/decorators/
    </decorator-prefix>

    <mapping
        path="/profile"
        decorator="admin.jsp" />

    <mapping
        path="/assets/*"
        exclude="true" />

    <mapping
        path="/image"
        exclude="true" />

    <mapping
        path="/login"
        exclude="true" />

    <mapping
        path="/register"
        exclude="true" />

</sitemesh>